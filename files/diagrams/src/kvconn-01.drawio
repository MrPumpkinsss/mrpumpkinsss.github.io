<mxfile host="app.diagrams.net">
  <diagram name="d" id="d">
    <mxGraphModel dx="1000" dy="600" grid="0" page="1" pageWidth="860" pageHeight="330" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
    <mxCell id="c2" value="① get_num_new_matched_tokens：命中多少 token？&lt;br&gt;返回 None 表示需要异步查询，调度器稍后再问" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3fd;strokeColor=#7a97d4;fontColor=#333333;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="44" width="340" height="46" as="geometry"/></mxCell>
    <mxCell id="c3" value="② update_state_after_alloc：分配块后登记&lt;br&gt;异步加载时同一请求可能被调两次" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3fd;strokeColor=#7a97d4;fontColor=#333333;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="340" height="40" as="geometry"/></mxCell>
    <mxCell id="c4" value="③ build_connector_meta：本步搬运计划 → Metadata&lt;br&gt;随 SchedulerOutput 下发" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e0a04a;fontColor=#333333;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="150" width="340" height="40" as="geometry"/></mxCell>
    <mxCell id="c5" value="④ bind_connector_metadata：步前绑定计划单&lt;br&gt;register_kv_caches：预先登记 paged KV buffer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3fd;strokeColor=#7a97d4;fontColor=#333333;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="454" y="44" width="388" height="40" as="geometry"/></mxCell>
    <mxCell id="c6" value="⑤ start_load_kv：forward 前启动异步加载&lt;br&gt;wait_for_layer_load：每层 attention 前逐层等&lt;br&gt;加载与上层计算重叠" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e0a04a;fontColor=#333333;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="454" y="94" width="388" height="58" as="geometry"/></mxCell>
    <mxCell id="c7" value="⑥ save_kv_layer：每层算完即异步保存&lt;br&gt;wait_for_save：步末统一收尾&lt;br&gt;异步保存必须扣住源块直到报完成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3fd;strokeColor=#7a97d4;fontColor=#333333;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="454" y="162" width="388" height="58" as="geometry"/></mxCell>
    <mxCell id="c8" value="⑦ update_connector_output：汇总完成 / 失败&lt;br&gt;get_finished / get_transfer_results" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3fd;strokeColor=#7a97d4;fontColor=#333333;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="200" width="340" height="46" as="geometry"/></mxCell>
    <mxCell id="c9" value="⑧ request_finished：接管块异步保存，可附参数&lt;br&gt;get_finished 归还后块才真正释放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f6ee;strokeColor=#59a97c;fontColor=#333333;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="256" width="340" height="46" as="geometry"/></mxCell>
    <mxCell id="c10" value="调度器副本（签单）" style="text;html=1;align=center;verticalAlign=middle;fontColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="134" y="11" width="132" height="20.8" as="geometry"/></mxCell>
    <mxCell id="c11" value="Worker 副本（搬货，每 TP rank）" style="text;html=1;align=center;verticalAlign=middle;fontColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="506" y="11" width="228" height="20.8" as="geometry"/></mxCell>
    <mxCell id="c12" value="worker 侧另有 take_events（KV 事件流）、get_kv_connector_stats（指标）、handle_preemptions（抢占前保护保存中的块）" style="text;html=1;align=left;verticalAlign=middle;fontColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="28" y="310" width="754" height="19.2" as="geometry"/></mxCell>
    <mxCell id="c13" style="html=1;endArrow=none;endFill=1;strokeColor=#7a879d;strokeWidth=1.4;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="32" as="sourcePoint"/><mxPoint x="200" y="316" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c14" style="html=1;endArrow=none;endFill=1;strokeColor=#7a879d;strokeWidth=1.4;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="32" as="sourcePoint"/><mxPoint x="620" y="316" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c15" style="html=1;endArrow=block;endFill=1;strokeColor=#7a879d;strokeWidth=1.4;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="170" as="sourcePoint"/><mxPoint x="452" y="196" as="targetPoint"/></mxGeometry></mxCell>
