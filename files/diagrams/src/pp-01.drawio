    <mxCell id="c26" value="时间 →" style="text;html=1;align=left;verticalAlign=middle;fontColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="14" y="10" width="48" height="19.2" as="geometry"/></mxCell>
    <mxCell id="c27" value="T0～T5＝连续 6 个调度步（step＝排一次批 + 各级各前向一次）" style="text;html=1;align=left;verticalAlign=middle;fontColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="14" y="28" width="381" height="19.2" as="geometry"/></mxCell>
