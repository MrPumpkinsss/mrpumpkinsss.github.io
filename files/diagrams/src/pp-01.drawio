    <mxCell id="c32" value="稳态（pp_size=4）：同一时刻 4 个在飞 step 错位分布在 4 个 stage 上，每个 stage 都有活干；颜色 = step。" style="text;html=1;align=left;verticalAlign=middle;fontColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="14" y="288" width="670" height="19.2" as="geometry"/></mxCell>
    <mxCell id="c33" value="同一请求两次 decode 至少隔 pp_size 步才会再被调度（decode_stagger，见下节），避免跨 step 的 KV 写冲突。" style="text;html=1;align=left;verticalAlign=middle;fontColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="14" y="307" width="676" height="19.2" as="geometry"/></mxCell>
