        </mxCell>
        <mxCell id="s1" value="① 各 rank 算词表分片&lt;br&gt;所有请求、owner-major 排列&lt;br&gt;padding 槽读请求 0 的行再丢弃" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3fd;strokeColor=#7a97d4;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
